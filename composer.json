{
  "name": "bricebou/better-typography",
  "type": "grav-plugin",
  "description": "Automatically improves the typography of your content. Provides a Twig filter.",
  "keywords": [
    "plugin",
    "grav",
    "typography"
  ],
  "homepage": "https://github.com/bricebou/grav-plugin-better-typography",
  "license": "MIT",
  "authors": [
    {
      "name": "Brice Boucard",
      "email": "brice@reclic.dev",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-mbstring": "*",
    "mundschenk-at/php-typography": "^7.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.5",
    "rector/rector": "^2.6",
    "symplify/easy-coding-standard": "^13.3"
  },
  "autoload": {
    "psr-4": {
      "Grav\\Plugin\\BetterTypography\\": "classes/"
    },
    "classmap": [
      "better-typography.php"
    ]
  },
  "config": {
    "platform": {
      "php": "8.3"
    },
    "sort-packages": true
  },
  "scripts": {
    "rector": "rector process",
    "rector:check": "rector process --dry-run",
    "ecs": "ecs check --fix",
    "ecs:check": "ecs check",
    "phpstan": "phpstan analyse",
    "check": [
      "@rector:check",
      "@ecs:check",
      "@phpstan",
      "@test"
    ],
    "vendor:release": "composer install --no-dev --prefer-dist --optimize-autoloader",
    "test": "phpunit"
  },
  "autoload-dev": {
    "psr-4": {
      "Grav\\Plugin\\BetterTypography\\Tests\\": "tests/"
    }
  }
}
